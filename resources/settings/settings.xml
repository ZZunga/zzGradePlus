<settings>
    <setting propertyKey="@Properties.appVersion" title="@Strings.VersionTitle">
        <settingConfig type="alphaNumeric" readonly="true"/>
    </setting>
    <setting propertyKey="@Properties.filterlen" title="@Strings.FilterTitle">
        <settingConfig type="list">
            <listEntry value="1">@Strings.Filter1</listEntry>
            <listEntry value="2">@Strings.Filter2</listEntry>
            <listEntry value="3">@Strings.Filter3</listEntry>
